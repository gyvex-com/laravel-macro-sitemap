{
    "name": "gyvex-com/laravel-macro-sitemap",
    "description": "Laravel Sitemap package to optimize your website in search engines",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "scrumble-nl/popo": "^1.0",
        "ext-dom": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "GyvexCom\\LaravelMacroSitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Niels Hamelink"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GyvexCom\\LaravelMacroSitemap\\SitemapServiceProvider"
            ]
        }
    }
}
